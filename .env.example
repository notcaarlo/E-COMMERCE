# ============================================================================
# StockGuard E-Commerce — Variables de Entorno (Opcional en Modo PGlite Demo)
# ============================================================================

# Clave secreta para firmar las cookies de sesión HTTP-only (HMAC-SHA256)
AUTH_SECRET="stockguard-portfolio-secret-hmac-key-2026"

# Por defecto el proyecto usa PostgreSQL real embebido (@electric-sql/pglite)
# sin necesidad de servidores externos.
# En Vercel (entorno serverless), usa memoria automáticamente.
PGLITE_IN_MEMORY="0"

# Opcional: URL de conexión si deseas usar el contenedor PostgreSQL de docker-compose.yml
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/stockguard?schema=public"
