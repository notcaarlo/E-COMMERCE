generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WAREHOUSE_OPERATOR
  SUPPORT
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  EXPIRED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED_EXPIRED
  RELEASED_CANCELLED
  COMMITTED
}

enum MovementType {
  RESTOCK
  RESERVE
  RELEASE_EXPIRED
  RELEASE_CANCELLED
  COMMIT_SALE
  RETURN_TO_AVAILABLE
  RETURN_TO_DAMAGED
  MANUAL_ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  orders            Order[]
  ledgerEntries     InventoryLedger[]
  orderStateChanges OrderStateHistory[]

  @@map("users")
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  location  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  inventoryItems InventoryItem[]

  @@map("warehouses")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  sku        String   @unique
  name       String
  attributes Json
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at")

  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  reservations   StockReservation[]
  ledgerEntries  InventoryLedger[]

  @@map("product_variants")
}

/// Consolidated stock balances per SKU and warehouse.
/// Enforces SQL CHECK constraint:
/// CHECK (on_hand >= 0 AND available >= 0 AND reserved >= 0 AND damaged >= 0 AND on_hand = available + reserved)
model InventoryItem {
  id          String   @id @default(cuid())
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  onHand      Int      @default(0) @map("on_hand")
  available   Int      @default(0)
  reserved    Int      @default(0)
  damaged     Int      @default(0)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ledgerEntries InventoryLedger[]

  @@unique([variantId, warehouseId])
  @@map("inventory_items")
}

/// Append-only Immutable Kardex / Inventory Ledger
model InventoryLedger {
  id              String       @id @default(cuid())
  inventoryItemId String       @map("inventory_item_id")
  variantId       String       @map("variant_id")
  movementType    MovementType @map("movement_type")
  quantityDelta   Int          @map("quantity_delta")
  onHandAfter     Int          @map("on_hand_after")
  availableAfter  Int          @map("available_after")
  reservedAfter   Int          @map("reserved_after")
  damagedAfter    Int          @map("damaged_after")
  referenceType   String       @map("reference_type")
  referenceId     String       @map("reference_id")
  actorId         String?      @map("actor_id")
  reason          String
  createdAt       DateTime     @default(now()) @map("created_at")

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor         User?          @relation(fields: [actorId], references: [id])

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_ledger")
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique @map("order_number")
  customerId           String      @map("customer_id")
  status               OrderStatus @default(PENDING_PAYMENT)
  totalCents           Int         @map("total_cents")
  idempotencyKey       String      @unique @map("idempotency_key")
  reservationExpiresAt DateTime    @map("reservation_expires_at")
  notes                String?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  customer      User                @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  reservations  StockReservation[]
  stateHistory  OrderStateHistory[]
  paymentEvents PaymentEvent[]

  @@index([status, reservationExpiresAt])
  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String @map("order_id")
  variantId         String @map("variant_id")
  skuSnapshot       String @map("sku_snapshot")
  nameSnapshot      String @map("name_snapshot")
  quantity          Int
  unitPriceCents    Int    @map("unit_price_cents")
  returnedToGood    Int    @default(0) @map("returned_to_good")
  returnedToDamaged Int    @default(0) @map("returned_to_damaged")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model StockReservation {
  id        String            @id @default(cuid())
  orderId   String            @map("order_id")
  variantId String            @map("variant_id")
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, status, expiresAt])
  @@map("stock_reservations")
}

model OrderStateHistory {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id")
  actorRole  String       @map("actor_role")
  reason     String
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_state_history")
}

model PaymentEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  orderId     String   @map("order_id")
  eventType   String   @map("event_type")
  outcome     String
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_events")
}
